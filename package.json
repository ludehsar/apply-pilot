{
  "name": "apply-pilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:infra": "docker compose up postgres",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile full up -d --build",
    "stack:down": "docker compose --profile full down"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
